{
  "name": "react-libs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "TypeScript-first React runtime libraries under @kristijorgji/*",
  "license": "MIT",
  "author": "kristijorgji",
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "ci:version": "changeset version && pnpm install --lockfile-only",
    "ci:publish": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
